{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zibanova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6fb80caa-f052-46e3-8844-5a1e9e72653b","database_name": "zibanova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "69f5ffe1d3dc4f3e9d5cba82a8219151" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
